# ---------------------------------------------------------------------------
# SYNCSPACE API - copy to `.env` and fill in the values.
#   cp .env.example .env
# Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=
PORT=

# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=

# Comma separated list of browser origins allowed to call this API.
# This must include the frontend origin so Socket.IO connections are accepted.
CORS_ORIGIN=

# Maximum upload size per shared file, in megabytes.
MAX_FILE_MB=

# AI Providers (optional - AI features need at least one of these).
# Get a Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get a Groq key: https://console.groq.com/keys
GROQ_API_KEY=
