# ---------------------------------------------------------------------------
# SYNCSPACE frontend.
#
# Base URL of the SYNCSPACE REST API and Socket.IO server, with no trailing
# slash. The same origin serves the REST API, the Socket.IO endpoint and the
# uploaded files, so this points at the backend origin in a split deployment.
#
# Development:  VITE_API_URL="http://localhost:5004"
#   (or leave it unset - local dev falls back to http://localhost:5004;
#    the Vite dev server also proxies /api, /uploads and /socket.io)
#
# Production (Vercel): REQUIRED. Must be your deployed Node/Express backend,
# never the Vercel frontend origin:
#   VITE_API_URL="https://YOUR-DEPLOYED-BACKEND-URL"
# Vite inlines this at build time, so set it in Vercel -> Project -> Settings
# -> Environment Variables (Production) and redeploy.
# ---------------------------------------------------------------------------
VITE_API_URL=
