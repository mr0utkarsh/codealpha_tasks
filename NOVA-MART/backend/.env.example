# ---------------------------------------------------------------------------
# NOVA MART API - copy to `.env` and fill in the values.
#   cp .env.example .env
# Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=
PORT=

# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=

# bcrypt cost factor used when hashing passwords.
BCRYPT_ROUNDS=

# Comma separated list of browser origins allowed to call this API.
CORS_ORIGIN=

# Business rules used to compute shipping at checkout.
FREE_SHIPPING_THRESHOLD=
SHIPPING_FEE=

# AI Providers (optional - AI features need at least one of these).
# Get a Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get a Groq key: https://console.groq.com/keys
GROQ_API_KEY=
